{
  // Workspace checks and operational tasks for the broker and MQTT inspection.
  //
  // Nothing here is required to build the project — `cargo build` does that.
  // CodeLLDB builds launch binaries through its Cargo integration; these tasks
  // keep the things a developer does constantly one keystroke away.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo: build workspace",
      "type": "cargo",
      "command": "build",
      "args": ["--workspace"],
      "problemMatcher": ["$rustc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      // Warnings are errors here, exactly as CI runs it.
      "label": "cargo: clippy (warnings are errors)",
      "type": "cargo",
      "command": "clippy",
      "args": [
        "--workspace",
        "--all-targets",
        "--all-features",
        "--",
        "-D",
        "warnings"
      ],
      "problemMatcher": ["$rustc"],
      "group": "build"
    },
    {
      // Without RHIZO_REQUIRE_BROKER the broker-backed tests print a loud skip
      // and pass, so this is green on a fresh clone. Use the task below to run
      // them for real.
      "label": "cargo: test workspace",
      "type": "cargo",
      "command": "test",
      "args": ["--workspace", "--all-features"],
      "problemMatcher": ["$rustc"],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      // What CI does: a missing Mosquitto is a failure rather than a skip,
      // because a suite that can silently skip its own subject proves nothing.
      "label": "cargo: test workspace (broker required)",
      "type": "cargo",
      "command": "test",
      "args": ["--workspace", "--all-features"],
      "options": { "env": { "RHIZO_REQUIRE_BROKER": "1" } },
      "problemMatcher": ["$rustc"],
      "group": "test"
    },
    {
      // Runs first in CI: dependency-free, no network, seconds.
      "label": "docs: validate planning artefacts",
      "type": "cargo",
      "command": "run",
      "args": ["-p", "rhizo-docscheck"],
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Mosquitto: up",
      "type": "shell",
      "command": "docker compose -f deploy/docker-compose.yml up -d --wait mosquitto",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" },
      "detail": "Starts the broker the edge and the simulators connect to."
    },
    {
      "label": "Mosquitto: logs",
      "type": "shell",
      "command": "docker compose -f deploy/docker-compose.yml logs -f mosquitto",
      "problemMatcher": [],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Mosquitto: down",
      "type": "shell",
      "command": "docker compose -f deploy/docker-compose.yml down",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      // The fastest way to understand what is actually on the wire.
      // Needs mosquitto_sub on PATH, and MQTT_PASSWORD from .env.
      "label": "MQTT: watch everything",
      "type": "shell",
      "command": "mosquitto_sub -h localhost -u rhizo-edge -P \"${env:MQTT_PASSWORD}\" -t 'rhizo/v1/#' -v",
      "problemMatcher": [],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "detail": "Every topic. Export MQTT_PASSWORD from .env first."
    },
    {
      // The property M5 exists to keep: nothing may appear here before M6.
      "label": "MQTT: watch command topics only",
      "type": "shell",
      "command": "mosquitto_sub -h localhost -u rhizo-edge -P \"${env:MQTT_PASSWORD}\" -t 'rhizo/v1/devices/+/commands/#' -v",
      "problemMatcher": [],
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "detail": "Silent through M5: the edge recommends, it does not act."
    },
    {
      "label": "Rhizo: Edge readiness",
      "type": "process",
      "command": "cargo",
      "args": ["run", "--quiet", "-p", "rhizo-devctl", "--", "edge", "readiness"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Rhizo: show Edge device state...",
      "type": "process",
      "command": "cargo",
      "args": ["run", "--quiet", "-p", "rhizo-devctl", "--", "edge", "device-state", "${input:rhizoDeviceId}"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Rhizo: show plant recommendation...",
      "type": "process",
      "command": "cargo",
      "args": ["run", "--quiet", "-p", "rhizo-devctl", "--", "edge", "plant-recommendation", "${input:rhizoPlantId}"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "detail": "Reads the latest persisted or on-demand Edge recommendation for a plant."
    },
    {
      "label": "Rhizo: simulator state",
      "type": "process",
      "command": "cargo",
      "args": ["run", "--quiet", "-p", "rhizo-devctl", "--", "simulator", "state"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true }
    },
    {
      "label": "Rhizo: set soil moisture...",
      "type": "process",
      "command": "cargo",
      "args": ["run", "--quiet", "-p", "rhizo-devctl", "--", "simulator", "set-soil", "${input:rhizoSoilMoisture}"],
      "problemMatcher": [],
      "presentation": { "reveal": "never", "focus": false, "panel": "shared", "showReuseMessage": false }
    },
    {
      "label": "Rhizo: simulate event...",
      "type": "process",
      "command": "cargo",
      "args": ["run", "--quiet", "-p", "rhizo-devctl", "--", "event", "${input:rhizoEvent}"],
      "problemMatcher": [],
      "presentation": { "reveal": "never", "focus": false, "panel": "shared", "showReuseMessage": false }
    },
    {
      "label": "Rhizo scenario: dry plant",
      "type": "process",
      "command": "cargo",
      "args": ["run", "--quiet", "-p", "rhizo-devctl", "--", "scenario", "dry-plant"],
      "problemMatcher": [],
      "presentation": { "reveal": "never", "focus": false, "panel": "shared", "showReuseMessage": false }
    },
    {
      "label": "Rhizo scenario: leak while dry",
      "type": "process",
      "command": "cargo",
      "args": ["run", "--quiet", "-p", "rhizo-devctl", "--", "scenario", "leak-while-dry"],
      "problemMatcher": [],
      "presentation": { "reveal": "never", "focus": false, "panel": "shared", "showReuseMessage": false }
    },
    {
      "label": "Rhizo scenario: battery missed wake",
      "type": "process",
      "command": "cargo",
      "args": ["run", "--quiet", "-p", "rhizo-devctl", "--", "scenario", "battery-missed-wake"],
      "problemMatcher": [],
      "presentation": { "reveal": "never", "focus": false, "panel": "shared", "showReuseMessage": false }
    },
    {
      "label": "Rhizo scenario: recover normal",
      "type": "process",
      "command": "cargo",
      "args": ["run", "--quiet", "-p", "rhizo-devctl", "--", "scenario", "recover-normal"],
      "problemMatcher": [],
      "presentation": { "reveal": "never", "focus": false, "panel": "shared", "showReuseMessage": false }
    },
    {
      "label": "⚠ Rhizo maintenance: RESET local dev state",
      "type": "process",
      "command": "cargo",
      "args": ["run", "--quiet", "-p", "rhizo-devctl", "--", "reset-local-state", "--confirmation", "${input:rhizoResetConfirmation}"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "focus": true, "panel": "shared", "clear": true, "showReuseMessage": false },
      "detail": "DESTRUCTIVE MAINTENANCE: type RESET, after stopping Edge and all simulators, to delete configured local development state."
    }
  ],
  "inputs": [
    {
      "id": "rhizoDeviceId",
      "type": "pickString",
      "description": "Edge device to inspect",
      "default": "plant-node-01",
      "options": ["plant-node-01", "plant-node-02"]
    },
    {
      "id": "rhizoPlantId",
      "type": "promptString",
      "description": "Edge plant ID to inspect",
      "default": "monstera-01"
    },
    {
      "id": "rhizoSoilMoisture",
      "type": "promptString",
      "description": "Soil moisture VWC percentage (0-100)",
      "default": "20"
    },
    {
      "id": "rhizoEvent",
      "type": "pickString",
      "description": "Simulator event or recovery action",
      "default": "dry-plant",
      "options": [
        "state",
        "dry-plant",
        "leak-on",
        "leak-off",
        "tank-empty",
        "tank-restore",
        "restart",
        "missed-wake",
        "disconnect",
        "reconnect",
        "recover-normal"
      ]
    },
    {
      "id": "rhizoResetConfirmation",
      "type": "promptString",
      "description": "Destructive maintenance: type RESET to delete local Edge and simulator state"
    }
  ]
}
