# Rhizo Edge — local environment template
#
# Copy to `.env` and replace every placeholder with a real value:
#
#     cp .env.example .env
#
# `.env` is gitignored and MUST NOT be committed. Secrets live here and in the
# generated `deploy/mosquitto/passwd`, never in `deploy/edge/edge.toml`
# (ADR-011 §Secrets): a config file gets pasted into a bug report, an
# environment variable does not.
#
# Every value below is a placeholder. Nothing here is a working credential.

# ---------------------------------------------------------------- MQTT broker
# Account used by the edge controller. Broad rights: `readwrite rhizo/v1/#`.
MQTT_USERNAME=rhizo-edge
MQTT_PASSWORD=change-me-edge-broker-password

# Per-device accounts. The username IS the device_id (ADR-012), and the
# Mosquitto ACL `pattern readwrite rhizo/v1/devices/%u/#` confines each account
# to its own subtree. Add one variable per device, following this shape:
#
#     RHIZO_DEVICE_<DEVICE_ID_WITH_UNDERSCORES>_PASSWORD=<password>
#
# `scripts/gen-mosquitto-passwd.sh` reads DEVICE_IDS and looks up each one, and
# the device simulator finds its own by the same convention — so one value here
# provisions the broker account and authenticates the device that uses it.
# Recommended password: 32 random bytes, base64 (ADR-012 §Credentials).
DEVICE_IDS=plant-node-01,plant-node-02
RHIZO_DEVICE_PLANT_NODE_01_PASSWORD=change-me-device-01-password
RHIZO_DEVICE_PLANT_NODE_02_PASSWORD=change-me-device-02-password

# ------------------------------------------------------- Edge instance config
# Layer L2 (ADR-011). These override `deploy/edge/edge.toml`; flags override
# these. Nested TOML keys use `__` as the separator.
RHIZO_EDGE__EDGE_ID=home-01
RHIZO_EDGE__MQTT__BROKER_URL=mqtt://localhost:1883
RHIZO_EDGE__MQTT__CLIENT_ID=rhizo-edge-home-01
RHIZO_EDGE__MQTT__USERNAME=rhizo-edge
# The MQTT password exists ONLY in this layer. A `password` key written into
# edge.toml is ignored and warned about at startup.
RHIZO_EDGE__MQTT__PASSWORD=change-me-edge-broker-password
RHIZO_EDGE__STORAGE__PATH=./data/edge.sqlite
RHIZO_EDGE__CONTROL__TICK_INTERVAL_SECONDS=30
RHIZO_EDGE__CONTROL__COMMAND_TTL_SECONDS=120
RHIZO_EDGE__CLOUD__ENABLED=false
RHIZO_EDGE__CLOUD__BASE_URL=http://localhost:8081
RHIZO_EDGE__API__BIND=127.0.0.1:8080
RHIZO_EDGE__LOG__LEVEL=info
RHIZO_EDGE__LOG__FORMAT=json

# ---------------------------------------------- Simulator development control
# The simulator-only HTTP control API is always loopback. VS Code tasks and
# `rhizo-devctl` read this same value, so no task embeds a development port.
RHIZO_SIMULATOR__CONTROL_BIND=127.0.0.1:9090

# ------------------------------------------------------------------ Cloud API
# Reserved for M7. Not consumed by any M0 service; documented here so the
# variable name is fixed before something invents a different one.
POSTGRES_USER=rhizo
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=rhizo_cloud

# Cloud API token — unused in V1, reserved for M14 (ADR-011 §Secrets).
RHIZO_CLOUD__API_TOKEN=
